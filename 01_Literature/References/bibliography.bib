  title = {Machine-{{Learning-Based High-Resolution Earthquake Catalog Reveals How Complex Fault Structures Were Activated}} during the 2016--2017 {{Central Italy Sequence}}},
  author = {Tan, Yen Joe and Waldhauser, Felix and Ellsworth, William L. and Zhang, Miao and Zhu, Weiqiang and Michele, Maddalena and Chiaraluce, Lauro and Beroza, Gregory C. and Segou, Margarita},
