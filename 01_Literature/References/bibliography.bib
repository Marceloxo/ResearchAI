@incollection{chen2025TopSUMsegTopologyAware,
  title = {{{TopSUMseg}}: {{A Topology-Aware Swin Transformer-Mamba Framework}} for {{3D Seismic Fault Image Segmentation}}},
  shorttitle = {{{TopSUMseg}}},
  booktitle = {Frontiers in {{Artificial Intelligence}} and {{Applications}}},
  author = {Chen, Ran and Deng, Jingyang and Zhang, Zeren and Shi, Ruohua and Ma, Jinwen},
  editor = {Lynce, In{\^e}s and Murano, Nello and Vallati, Mauro and Villata, Serena and Chesani, Federico and Milano, Michela and Omicini, Andrea and Dastani, Mehdi},
  year = 2025,
  month = oct,
  publisher = {IOS Press},
  doi = {10.3233/FAIA250865},
  urldate = {2026-07-20},
  abstract = {Seismic fault image segmentation is crucial for interpreting subsurface geological structures, supporting geologists in resource exploration and structural analysis. However, current deep learning models struggle with single-architecture limitations and the distinctive characteristics of seismic faults, which are distinguished by elongated structures with uneven spatial distributions. To address these challenges, we propose TopSUMseg, a novel Topology-Aware Swin Transformer-Mamba framework for 3D seismic fault image segmentation. Our framework combines Swin Transformer's local feature extraction with Mamba's efficient sequence modeling, and boosts 3D spatial modeling in Mamba with a newly designed Global-Local Attention module (GLA). Additionally, we design a Topology-Aware Structural Constraint (TASC) to align predictions with ground-truth structures in the feature space, promoting the modeling of complex fault geometries. Experiments on Thebe, the largest public seismic dataset, demonstrate that TopSUMseg achieves state-of-the-art performance with OIS and ODS scores of 0.879 and 0.875, respectively. Trained entirely from scratch, TopSUMseg nonetheless achieves superior performance compared to extensively pre-trained counterparts. In addition, TopSUMseg maintains a significantly lower parameter count while achieving a favorable trade-off between segmentation performance and time complexity, making it a practical and generalizable solution for real-world seismic fault interpretation.},
  copyright = {https://creativecommons.org/licenses/by-nc/4.0/},
  isbn = {978-1-64368-631-8},
  file = {/home/lco/ResearchAI_Data/Zotero/storage/M29ILMXG/Chen et al. - 2025 - TopSUMseg A Topology-Aware Swin Transformer-Mamba Framework for 3D Seismic Fault Image Segmentation.pdf}
}

@article{di2026FaultEdgeFormeredge,
  title = {{{FaultEdgeFormer}}: An Edge Enhanced Transformer Model for {{3D}} Seismic Fault Detection},
  shorttitle = {{{FaultEdgeFormer}}},
  author = {Di, Xi and Liu, Yang and Chang, Suoliang and Tian, Wenbin and Ma, Jiangtao and Dong, Zilong},
  year = 2026,
  month = may,
  journal = {Journal of Geophysics and Engineering},
  volume = {23},
  number = {4},
  pages = {1285--1311},
  issn = {1742-2132, 1742-2140},
  doi = {10.1093/jge/gxag041},
  urldate = {2026-07-20},
  abstract = {Abstract             Fault detection plays a critical role in interpreting seismic data. Deep learning methods, particularly convolutional neural networks (CNNs), have demonstrated strong potential in fault detection tasks. However, current CNN-based methods face two key challenges. One is that the optimization of CNN kernels begins with randomly initialized weights, which restricts these kernels' capability to emphasize fault related features during the early training process. The other is that existing CNN-based architectures are unable to learn global contextual information due to the fixed kernel size and limited receptive fields of convolutional operations. To overcome these challenges, we propose an edge enhanced transformer model to improve 3D fault detection performance (FaultEdgeFormer). First, faults can be characterized as edges within the seismic data. Traditional edge detection operators, such as Sobel kernels, explicitly calculate gradient information for edge features. Based on this observation, a trainable Sobel convolution is proposed for the first layer of the network. The predefined weights in the trainable Sobel convolution can adaptively enhance edge information, constraining the network to focus on fault related features. Second, an improved Swin transformer block is proposed to extract long-range dependencies through the attention mechanisms, while integrates the locality of convolutional operations. This improvement is achieved through two primary modifications: introducing convolutional projections into the window-based self-attention mechanism and incorporating depthwise convolutions within the multilayer perceptron (MLP). Experimental results demonstrate that the proposed FaultEdgeFormer outperforms both CNN-based methods and Transformer-based methods on several synthetic and field seismic datasets, delivering more accurate fault predictions with better continuity and resolution.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  file = {/home/lco/ResearchAI_Data/Zotero/storage/MVSQQ8TY/Di et al. - 2026 - FaultEdgeFormer an edge enhanced transformer model for 3D seismic fault detection.pdf}
}

